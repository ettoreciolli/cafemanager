{
  "name": "@cafemanager/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "prisma generate --watch",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:seed": "bun src/seed.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prisma": "^6.19.3",
    "tsup": "^8.3.5",
    "typescript": "^5.2.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
