{
  "name": "@cafemanager/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "prisma generate --watch",
    "db:validate": "bun --bun run prisma validate --schema ./prisma/schema.prisma",
    "db:generate": "bun --bun run prisma generate",
    "db:pull": "bun --bun run prisma db pull",
    "db:push": "bun --bun run prisma db push --accept-data-loss",
    "db:seed": "bun src/seed.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.2.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  }
}
