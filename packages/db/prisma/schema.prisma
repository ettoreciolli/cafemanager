generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cafe {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  address     String
  description String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[] @relation("user_selected_cafe_fk")
  ownerId     String
  owner       User    @relation("cafe_owner_fk", fields: [ownerId], references: [id], onDelete: Cascade)
}

model Delivery {
  id           String     @id @default(uuid())
  ingredientId String
  supplierId   String
  status       String     @default("scheduled")
  quantity     Float      @default(0)
  scheduledAt  DateTime
  deliveredAt  DateTime?
  createdAt    DateTime   @default(now())
  price        Float      @default(0)
  Ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  Supplier     Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Ingredient {
  id                 String               @id @default(uuid())
  name               String
  unit               String
  stockQuantity      Float                @default(0)
  minStock           Float                @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  Delivery           Delivery[]
  MenuItemIngredient MenuItemIngredient[]
  SupplierIngredient SupplierIngredient[]
}

model MenuItem {
  id                 String               @id @default(uuid())
  name               String
  description        String?
  price              Float
  imageUrl           String?
  available          Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  MenuItemIngredient MenuItemIngredient[]
  OrderItem          OrderItem[]
}

model MenuItemIngredient {
  id           String     @id @default(uuid())
  menuItemId   String
  ingredientId String
  quantity     Float      @default(1)
  Ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  MenuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
}

model Order {
  id            String      @id @default(uuid())
  externalId    String?     @unique
  customerName  String?
  customerEmail String?
  status        String      @default("received")
  total         Float       @default(0)
  currency      String      @default("USD")
  source        String      @default("webhook")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  OrderItem     OrderItem[]
}

model OrderItem {
  id         String    @id @default(uuid())
  orderId    String
  menuItemId String?
  name       String
  quantity   Int       @default(1)
  MenuItem   MenuItem? @relation(fields: [menuItemId], references: [id])
  Order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Staff {
  id         String   @id @default(uuid())
  name       String
  email      String?  @unique
  phone      String?
  role       String   @default("staff")
  hourlyRate Float    @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Supplier {
  id                 String               @id @default(uuid())
  name               String
  contact            String?
  email              String?
  address            String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt 
  Delivery           Delivery[]
  SupplierIngredient SupplierIngredient[]
}

model SupplierIngredient {
  id           String     @id @default(uuid())
  supplierId   String
  ingredientId String
  leadTimeDays Int        @default(1)
  Ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  Supplier     Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, ingredientId])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String?
  passwordHash String?
  googleId     String?   @unique
  provider     String    @default("password")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  currency       String    @default("USD")
  selectedCafeId String?  
  selectedCafe  Cafe?  @relation("user_selected_cafe_fk", fields: [selectedCafeId], references: [id], onDelete: SetNull)
  ownedCafes      Cafe[]  @relation("cafe_owner_fk")
  Session        Session[]
  hasOnboarded    Boolean   @default(false)
}
