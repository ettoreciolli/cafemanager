{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "packages/db"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        ".turbo/**",
        "dist/**"
      ]
    },
    "lint": {
      "cache": false
    },
    "typecheck": {
      "cache": true,
      "outputs": []
    },
    "sim": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}